@@ -0,0 +1,64 @@
+import { Body, Controller, Get, Param, Put } from '@nestjs/common';
+import { ApiTags } from '@nestjs/swagger';
+import type { AuthDto } from 'src/dtos/auth.dto.js';
+import { Endpoint, HistoryBuilder } from 'src/decorators.js';
+import {
+  AssetSensitiveResponseDto,
+  PersonSensitiveResponseDto,
+  PersonSensitiveUpdateDto,
+} from 'src/dtos/sensitive.dto.js';
+import { ApiTag, Permission, RouteKey } from 'src/enum.js';
+import { Auth, Authenticated } from 'src/middleware/auth.guard.js';
+import { SensitiveService } from 'src/services/sensitive.service.js';
+import { UUIDParamDto } from 'src/validation.js';
+
+@ApiTags(ApiTag.Assets)
+@Controller(RouteKey.Asset)
+export class SensitiveController {
+  constructor(private service: SensitiveService) {}
+
+  @Get(':id/sensitive')
+  @Authenticated({ permission: Permission.AssetRead, sharedLink: true })
+  @Endpoint({
+    summary: 'Retrieve whether an asset is sensitive',
+    description:
+      'Whether the asset carries the sensitive tag (IMMICH_SENSITIVE_TAG, or a tag under it) or shows a person marked sensitive, and whether its media is withheld until the session is unlocked with the PIN.',
+    history: new HistoryBuilder().added('v3.3.5'),
+  })
+  getSensitive(@Auth() auth: AuthDto, @Param() { id }: UUIDParamDto): Promise<AssetSensitiveResponseDto> {
+    return this.service.getAsset(auth, id);
+  }
+}
+
+@ApiTags(ApiTag.People)
+@Controller('people')
+export class SensitivePersonController {
+  constructor(private service: SensitiveService) {}
+
+  @Get(':id/sensitive')
+  @Authenticated({ permission: Permission.PersonRead })
+  @Endpoint({
+    summary: 'Retrieve whether a person is sensitive',
+    description: 'Whether every asset showing this person is hidden until the session is unlocked with the PIN.',
+    history: new HistoryBuilder().added('v3.3.5'),
+  })
+  getSensitive(@Auth() auth: AuthDto, @Param() { id }: UUIDParamDto): Promise<PersonSensitiveResponseDto> {
+    return this.service.getPerson(auth, id);
+  }
+
+  @Put(':id/sensitive')
+  @Authenticated({ permission: Permission.PersonUpdate })
+  @Endpoint({
+    summary: 'Mark a person sensitive',
+    description:
+      'Hide every asset showing this person until the session is unlocked with the PIN. Showing them again requires an unlocked session.',
+    history: new HistoryBuilder().added('v3.3.5'),
+  })
+  updateSensitive(
+    @Auth() auth: AuthDto,
+    @Param() { id }: UUIDParamDto,
+    @Body() dto: PersonSensitiveUpdateDto,
+  ): Promise<PersonSensitiveResponseDto> {
+    return this.service.updatePerson(auth, id, dto);
+  }
+}
