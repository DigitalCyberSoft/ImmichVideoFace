+import { createZodDto } from 'nestjs-zod';
+import z from 'zod';
+
+const AssetSensitiveResponseSchema = z
+  .object({
+    sensitive: z.boolean().describe('Whether the asset carries the sensitive tag, or shows a person marked sensitive'),
+    hidden: z.boolean().describe('Whether its media is withheld until the session is unlocked with the PIN'),
+    tag: z.string().describe('The sensitive tag (IMMICH_SENSITIVE_TAG); empty when tags are not used'),
+  })
+  .meta({ id: 'AssetSensitiveResponseDto' });
+
+const PersonSensitiveResponseSchema = z
+  .object({
+    sensitive: z.boolean().describe('Whether every asset showing this person is hidden until the PIN is entered'),
+    hidden: z.boolean().describe('Whether that applies to this session now (it is not unlocked)'),
+    available: z.boolean().describe('Whether people can be marked sensitive on this server'),
+  })
+  .meta({ id: 'PersonSensitiveResponseDto' });
+
+const PersonSensitiveUpdateSchema = z
+  .object({
+    sensitive: z.boolean().describe('Hide every asset showing this person until the PIN is entered'),
+  })
+  .meta({ id: 'PersonSensitiveUpdateDto' });
+
+export class AssetSensitiveResponseDto extends createZodDto(AssetSensitiveResponseSchema) {}
+export class PersonSensitiveResponseDto extends createZodDto(PersonSensitiveResponseSchema) {}
+export class PersonSensitiveUpdateDto extends createZodDto(PersonSensitiveUpdateSchema) {}
