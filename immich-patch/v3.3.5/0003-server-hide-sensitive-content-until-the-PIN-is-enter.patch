+import sharp from 'sharp';
+import { renderSensitivePlaceholder } from 'src/utils/sensitive.js';
+
+describe('renderSensitivePlaceholder', () => {
+  it('renders a webp at the thumbhash aspect ratio', async () => {
+    const { rgbaToThumbHash } = await import('thumbhash');
+    const width = 40;
+    const height = 20;
+    const rgba = new Uint8Array(width * height * 4).fill(200);
+    const hash = Buffer.from(rgbaToThumbHash(width, height, rgba));
+
+    const meta = await sharp(await renderSensitivePlaceholder(hash)).metadata();
+
+    expect(meta.format).toBe('webp');
+    expect(meta.width).toBe(480);
+    // A thumbhash keeps the aspect ratio only approximately.
+    expect(meta.height! / meta.width!).toBeGreaterThan(0.4);
+    expect(meta.height! / meta.width!).toBeLessThan(0.7);
+  });
+
+  it('renders a neutral square without a thumbhash', async () => {
+    const meta = await sharp(await renderSensitivePlaceholder(null)).metadata();
+    expect([meta.width, meta.height]).toEqual([480, 480]);
+  });
+});
