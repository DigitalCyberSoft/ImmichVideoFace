+import { ServiceMocks, newTestService } from 'test/utils.js';
+
+const unlocked = (auth = AuthFactory.create()) => ({
+  ...auth,
+  session: { id: 'session-1', hasElevatedPermission: true },
+});
+
+describe(SensitiveService.name, () => {
+  let sut: SensitiveService;
+  let mocks: ServiceMocks;
+
+  beforeEach(() => {
+    ({ sut, mocks } = newTestService(SensitiveService));
+  });
+
+  const allow = (auth: { user: { id: string } }, personGroupId: string) =>
+    mocks.access.person.checkAccess.mockResolvedValue(new Set([{ personGroupId, ownerId: auth.user.id }]));
+
+  it('marks a person sensitive without the PIN', async () => {
+    const auth = AuthFactory.create();
+    const person = PersonFactory.create();
+    allow(auth, person.personGroupId);
+    mocks.person.setSensitive.mockResolvedValue(true);
+    mocks.person.isSensitive.mockResolvedValue(true);
+    mocks.person.sensitiveAvailable.mockResolvedValue(true);
+
+    await expect(sut.updatePerson(auth, person.personGroupId, { sensitive: true })).resolves.toEqual({
+      sensitive: true,
+      hidden: true,
+      available: true,
+    });
+    expect(mocks.person.setSensitive).toHaveBeenCalledWith(auth.user.id, person.personGroupId, true);
+  });
+
+  it('needs an unlocked session to show a person again', async () => {
+    const auth = AuthFactory.create();
+    const person = PersonFactory.create();
+    allow(auth, person.personGroupId);
+
+    await expect(sut.updatePerson(auth, person.personGroupId, { sensitive: false })).rejects.toBeInstanceOf(
+      UnauthorizedException,
+    );
+    expect(mocks.person.setSensitive).not.toHaveBeenCalled();
+
+    const open = unlocked(auth);
+    mocks.person.setSensitive.mockResolvedValue(true);
+    mocks.person.isSensitive.mockResolvedValue(false);
+    await expect(sut.updatePerson(open, person.personGroupId, { sensitive: false })).resolves.toMatchObject({
+      sensitive: false,
+      hidden: false,
+    });
+  });
+
+  it('requires access to the person', async () => {
+    const person = PersonFactory.create();
+    await expect(
+      sut.updatePerson(AuthFactory.create(), person.personGroupId, { sensitive: true }),
+    ).rejects.toBeInstanceOf(BadRequestException);
+    expect(mocks.person.setSensitive).not.toHaveBeenCalled();
+  });
+});
+
+describe('PersonService thumbnails of sensitive people', () => {
