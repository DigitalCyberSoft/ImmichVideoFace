@@ -1006,4 +1007,35 @@ export class PersonRepository {
       .where('person.personGroupId', 'in', personGroupIds)
       .execute();
   }
+
+  /** Whether people can be marked sensitive: the video index has the table for it. */
+  async sensitiveAvailable(): Promise<boolean> {
+    const tables = await videoIndexTables(this.db);
+    return tables.has('sensitive_person');
+  }
+
+  /** Whether this person is marked sensitive (see VideoIndexRepository). */
+  async isSensitive(personGroupId: string): Promise<boolean> {
+    if (!(await this.sensitiveAvailable())) {
+      return false;
+    }
+    const { rows } = await sql<{ one: number }>`
+      select 1 as one from ${sql.id(VIDEO_INDEX_SCHEMA, 'sensitive_person')} where person_group_id = ${personGroupId}::uuid
+    `.execute(this.db);
+    return rows.length > 0;
+  }
+
+  /** Mark or unmark a person sensitive. False when the table is missing. */
+  async setSensitive(ownerId: string, personGroupId: string, sensitive: boolean): Promise<boolean> {
+    if (!(await this.sensitiveAvailable())) {
+      return false;
+    }
+    const table = sql.id(VIDEO_INDEX_SCHEMA, 'sensitive_person');
+    await (
+      sensitive
+        ? sql`insert into ${table} (owner_id, person_group_id) values (${ownerId}::uuid, ${personGroupId}::uuid) on conflict do nothing`
+        : sql`delete from ${table} where person_group_id = ${personGroupId}::uuid`
+    ).execute(this.db);
+    return true;
+  }
 }
