+import { BadRequestException, Injectable } from '@nestjs/common';
+import { AuthDto } from 'src/dtos/auth.dto.js';
+import {
+  AssetSensitiveResponseDto,
+  PersonSensitiveResponseDto,
+  PersonSensitiveUpdateDto,
+} from 'src/dtos/sensitive.dto.js';
+import { Permission } from 'src/enum.js';
+import { BaseService } from 'src/services/base.service.js';
+import { requireElevatedPermission } from 'src/utils/access.js';
+import { SENSITIVE_TAG, getSensitiveState } from 'src/utils/sensitive.js';
+
+/** Sensitive assets and people: what is hidden until the PIN is entered (see utils/sensitive). */
+@Injectable()
+export class SensitiveService extends BaseService {
+  async getAsset(auth: AuthDto, id: string): Promise<AssetSensitiveResponseDto> {
+    await this.requireAccess({ auth, permission: Permission.AssetRead, ids: [id] });
+    const { sensitive, hidden } = await getSensitiveState(this.tagRepository, auth, id);
+    return { sensitive, hidden, tag: SENSITIVE_TAG };
+  }
+
+  async getPerson(auth: AuthDto, personGroupId: string): Promise<PersonSensitiveResponseDto> {
+    await this.requirePersonAccess({
+      auth,
+      permission: Permission.PersonRead,
+      ids: [{ personGroupId, ownerId: auth.user.id }],
+    });
+    const sensitive = await this.personRepository.isSensitive(personGroupId);
+    const available = await this.personRepository.sensitiveAvailable();
+    return { sensitive, hidden: sensitive && !auth.session?.hasElevatedPermission, available };
+  }
+
+  async updatePerson(
+    auth: AuthDto,
+    personGroupId: string,
+    dto: PersonSensitiveUpdateDto,
+  ): Promise<PersonSensitiveResponseDto> {
+    await this.requirePersonAccess({
+      auth,
+      permission: Permission.PersonUpdate,
+      ids: [{ personGroupId, ownerId: auth.user.id }],
+    });
+    // Hiding someone needs nothing; showing them again needs the PIN, like viewing them.
+    if (!dto.sensitive) {
+      requireElevatedPermission(auth);
+    }
+    if (!(await this.personRepository.setSensitive(auth.user.id, personGroupId, dto.sensitive))) {
+      throw new BadRequestException(
+        'People cannot be marked sensitive: the video index schema has no sensitive_person table',
+      );
+    }
+    return this.getPerson(auth, personGroupId);
+  }
+}
