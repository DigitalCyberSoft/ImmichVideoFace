@@ -230,6 +233,40 @@ export class TagRepository {
     }
   }
 
+  /**
+   * The asset, when it is sensitive; otherwise undefined. Sensitive means it carries
+   * `tagValue` or a tag under it (`tagValue/...`), or shows a person marked sensitive
+   * (see VideoIndexRepository), directly or through the Live Photo still it is the
+   * motion part of. An empty `tagValue` checks people only.
+   */
+  @GenerateSql({ params: [DummyValue.UUID, DummyValue.STRING] })
+  async getSensitive(assetId: string, tagValue: string) {
+    const tables = await videoIndexTables(this.db);
+    const withPeople = tables.has('sensitive_person');
+    const under = `${tagValue.replaceAll(/[\\%_]/g, (c) => `\\${c}`)}/%`;
+    const tagged = tagValue
+      ? sql`exists (
+          select 1 from tag_asset ta join tag t on t.id = ta."tagId"
+          where ta."assetId" in (select id from target) and (t.value = ${tagValue} or t.value like ${under}))`
+      : sql`false`;
+    const shown = withPeople
+      ? sql`exists (
+          select 1 from asset_face af
+          join ${sql.id(VIDEO_INDEX_SCHEMA, 'sensitive_person')} sp on sp.person_group_id = af."personGroupId"
+          where af."assetId" in (select id from target) and af."deletedAt" is null and af."isVisible")`
+      : sql`false`;
+    const { rows } = await sql<{ id: string; type: AssetType; thumbhash: Buffer | null }>`
+      with target as (
+        select ${assetId}::uuid as id
+        union all
+        select still.id from asset still where still."livePhotoVideoId" = ${assetId}::uuid
+      )
+      select asset.id, asset.type, asset.thumbhash from asset
+      where asset.id = ${assetId}::uuid and (${tagged} or ${shown})
+    `.execute(this.db);
+    return rows[0];
+  }
+
   insertTagWithClosures(insertTag: (db: QueryCreator<DB>) => InsertQueryBuilder<DB, 'tag', Selectable<TagTable>>) {
     return this.db
       .with('created_tag', insertTag)
