@@ -0,0 +1,102 @@
+import { ForbiddenException } from '@nestjs/common';
+import { mkdir, rename, stat, writeFile } from 'node:fs/promises';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import sharp, { Sharp } from 'sharp';
+import { AuthDto } from 'src/dtos/auth.dto.js';
+import { AssetType, CacheControl } from 'src/enum.js';
+import { TagRepository } from 'src/repositories/tag.repository.js';
+import { ImmichFileResponse } from 'src/utils/file.js';
+
+/**
+ * Sensitive content: an asset tagged with this tag, or with one under it such as
+ * `Sensitive/Explicit`, or showing a person marked sensitive, stays in the timeline,
+ * search and albums, but every image of it is served as a blurred placeholder, and its
+ * video and original are refused, until the session is unlocked with the user's PIN
+ * (the same unlock as the Locked Folder). A Live Photo's motion part follows its still.
+ * Empty turns off the tag; people marked sensitive still apply.
+ */
+export const SENSITIVE_TAG = process.env.IMMICH_SENSITIVE_TAG ?? 'Sensitive';
+
+export type SensitiveState =
+  { sensitive: false; hidden: false } | { sensitive: true; hidden: boolean; type: AssetType; thumbhash: Buffer | null };
+
+const NOT_SENSITIVE: SensitiveState = { sensitive: false, hidden: false };
+
+export const getSensitiveState = async (
+  tagRepository: TagRepository,
+  auth: AuthDto,
+  assetId: string,
+): Promise<SensitiveState> => {
+  const row = await tagRepository.getSensitive(assetId, SENSITIVE_TAG);
+  if (!row) {
+    return NOT_SENSITIVE;
+  }
+  // Shared links and API keys have no session to unlock, so they always see the placeholder.
+  const hidden = !auth.session?.hasElevatedPermission;
+  return { sensitive: true, hidden, type: row.type, thumbhash: row.thumbhash };
+};
+
+/** Sensitive media must not be reused from a browser cache once the session locks again. */
+export const sensitiveCacheControl = (state: SensitiveState, otherwise: CacheControl) =>
+  state.sensitive ? CacheControl.PrivateWithoutCache : otherwise;
+
+export const refuseSensitive = () => {
+  throw new ForbiddenException('Sensitive content: unlock with your PIN to view it');
+};
+
+const PLACEHOLDER_DIR = join(tmpdir(), 'immich-sensitive');
+const PLACEHOLDER_WIDTH = 480;
+// mdiEyeOff
+const EYE_OFF =
+  'M11.83,9L15,12.16C15,12.11 15,12.05 15,12A3,3 0 0,0 12,9C11.94,9 11.89,9 11.83,9M7.53,9.8L9.08,11.35C9.03,11.56 9,11.77 9,12A3,3 0 0,0 12,15C12.22,15 12.44,14.97 12.65,14.92L14.2,16.47C13.53,16.8 12.79,17 12,17A5,5 0 0,1 7,12C7,11.21 7.2,10.47 7.53,9.8M2,4.27L4.28,6.55L4.73,7C3.08,8.3 1.78,10 1,12C2.73,16.39 7,19.5 12,19.5C13.55,19.5 15.03,19.2 16.38,18.66L16.81,19.08L19.73,22L21,20.73L3.27,3M12,7A5,5 0 0,1 17,12C17,12.64 16.87,13.26 16.64,13.82L19.57,16.75C21.07,15.5 22.27,13.86 23,12C21.27,7.61 17,4.5 12,4.5C10.6,4.5 9.26,4.75 8,5.2L10.17,7.35C10.74,7.13 11.35,7 12,7Z';
+
+/**
+ * The asset's thumbhash (the blurred placeholder Immich already shows while a thumbnail
+ * loads) enlarged, darkened, and marked with a crossed-out eye. Rendered once per asset
+ * and thumbhash into the server's private temp directory.
+ */
+export const renderSensitivePlaceholder = async (thumbhash: Buffer | null): Promise<Buffer> => {
+  let base: Sharp;
+  let ratio = 1;
+  if (thumbhash && thumbhash.length > 0) {
+    const { thumbHashToRGBA } = await import('thumbhash');
+    const { w, h, rgba } = thumbHashToRGBA(thumbhash);
+    ratio = h / w;
+    base = sharp(Buffer.from(rgba), { raw: { width: w, height: h, channels: 4 } });
+  } else {
+    base = sharp({ create: { width: 4, height: 4, channels: 4, background: '#4b5563' } });
+  }
+  const width = PLACEHOLDER_WIDTH;
+  const height = Math.max(1, Math.round(width * Math.min(Math.max(ratio, 0.25), 4)));
+  const icon = Math.round(Math.min(width, height) * 0.3);
+  const overlay = Buffer.from(
+    `<svg xmlns="http://www.w3.org/2000/svg" width="${width}" height="${height}">` +
+      `<rect width="100%" height="100%" fill="#000" fill-opacity="0.35"/>` +
+      `<g transform="translate(${(width - icon) / 2},${(height - icon) / 2}) scale(${icon / 24})">` +
+      `<path fill="#fff" fill-opacity="0.9" d="${EYE_OFF}"/></g></svg>`,
+  );
+  const blurred = await base.resize(width, height, { kernel: 'cubic', fit: 'fill' }).blur(12).png().toBuffer();
+  return sharp(blurred)
+    .composite([{ input: overlay }])
+    .webp({ quality: 70 })
+    .toBuffer();
+};
+
+export const sensitivePlaceholder = async (id: string, thumbhash: Buffer | null) => {
+  const key = thumbhash ? thumbhash.toString('hex').slice(0, 16) : 'none';
+  const path = join(PLACEHOLDER_DIR, `${id}-${key}.webp`);
+  try {
+    await stat(path);
+  } catch {
+    await mkdir(PLACEHOLDER_DIR, { recursive: true });
+    const partial = `${path}.${process.pid}.tmp`;
+    await writeFile(partial, await renderSensitivePlaceholder(thumbhash));
+    await rename(partial, path);
+  }
+  return new ImmichFileResponse({
+    path,
+    contentType: 'image/webp',
+    cacheControl: CacheControl.PrivateWithoutCache,
+  });
+};
