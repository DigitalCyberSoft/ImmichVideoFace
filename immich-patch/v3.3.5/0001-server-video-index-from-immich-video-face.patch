@@ -0,0 +1,90 @@
+import { BadRequestException } from '@nestjs/common';
+import { describe, expect, it, vitest } from 'vitest';
+import { mergeSegments } from 'src/repositories/video-index.repository.js';
+import { VideoIndexService } from 'src/services/video-index.service.js';
+import { authStub } from 'test/fixtures/auth.stub.js';
+
+const assetId = '00000000-0000-4000-8000-000000000001';
+
+const setup = (allowed: boolean, hasAppearances = true, rows: unknown[] = []) => {
+  const none = () => vitest.fn().mockResolvedValue(new Set());
+  const access = {
+    asset: {
+      checkOwnerAccess: vitest.fn().mockResolvedValue(new Set(allowed ? [assetId] : [])),
+      checkAlbumAccess: none(),
+      checkPartnerAccess: none(),
+    },
+  };
+  const videoIndex = {
+    hasAppearances: vitest.fn().mockResolvedValue(hasAppearances),
+    getAppearances: vitest.fn().mockResolvedValue(rows),
+  };
+  return { sut: new VideoIndexService(access as any, videoIndex as any), videoIndex };
+};
+
+describe(VideoIndexService.name, () => {
+  it('requires access to the asset', async () => {
+    const { sut, videoIndex } = setup(false);
+    await expect(sut.getAppearances(authStub.user1, assetId)).rejects.toBeInstanceOf(BadRequestException);
+    expect(videoIndex.getAppearances).not.toHaveBeenCalled();
+  });
+
+  it('returns nothing when the video index is not installed', async () => {
+    const { sut, videoIndex } = setup(true, false);
+    await expect(sut.getAppearances(authStub.user1, assetId)).resolves.toEqual({ durationMs: null, appearances: [] });
+    expect(videoIndex.getAppearances).not.toHaveBeenCalled();
+  });
+
+  it('orders people by screen time', async () => {
+    const updatedAt = new Date('2026-11-04T00:00:00.000Z');
+    const { sut } = setup(true, true, [
+      {
+        durationMs: 9000,
+        personId: 'a',
+        name: 'Brief',
+        isHidden: false,
+        color: null,
+        updatedAt,
+        segments: [[0, 1000]],
+      },
+      {
+        durationMs: 9000,
+        personId: 'b',
+        name: 'Long',
+        isHidden: false,
+        color: '#ff0000',
+        updatedAt,
+        segments: [
+          [0, 4000],
+          [6000, 8000],
+        ],
+      },
+    ]);
+    const { durationMs, appearances } = await sut.getAppearances(authStub.user1, assetId);
+    expect(durationMs).toBe(9000);
+    expect(appearances.map((a) => a.person.name)).toEqual(['Long', 'Brief']);
+    expect(appearances[0]).toEqual({
+      person: { id: 'b', name: 'Long', isHidden: false, color: '#ff0000', updatedAt: updatedAt.toISOString() },
+      segments: [
+        [0, 4000],
+        [6000, 8000],
+      ],
+    });
+    expect(appearances[1].person.color).toBeUndefined();
+  });
+});
+
+describe('mergeSegments', () => {
+  it('sorts and unions overlapping intervals', () => {
+    expect(
+      mergeSegments([
+        [5000, 6000],
+        [0, 2000],
+        [1500, 3000],
+      ]),
+    ).toEqual([
+      [0, 3000],
+      [5000, 6000],
+    ]);
+  });
+});
diff --git a/server/src/services/video-index.service.ts b/server/src/services/video-index.service.ts
new file mode 100644
index 0000000..59334ef
--- /dev/null
+++ b/server/src/services/video-index.service.ts
@@ -0,0 +1,40 @@
+import { Injectable } from '@nestjs/common';
+import { AuthDto } from 'src/dtos/auth.dto.js';
+import { VideoAppearanceDto, VideoAppearancesResponseDto } from 'src/dtos/video-index.dto.js';
+import { Permission } from 'src/enum.js';
+import { AccessRepository } from 'src/repositories/access.repository.js';
+import { VideoIndexRepository } from 'src/repositories/video-index.repository.js';
+import { requireAccess } from 'src/utils/access.js';
+
+const screenTime = (segments: [number, number][]) => segments.reduce((sum, [start, end]) => sum + end - start, 0);
+
+/** Who is on screen when in a video, from the immich-video-face index. */
+@Injectable()
+export class VideoIndexService {
+  constructor(
+    private accessRepository: AccessRepository,
+    private videoIndexRepository: VideoIndexRepository,
+  ) {}
+
+  async getAppearances(auth: AuthDto, id: string): Promise<VideoAppearancesResponseDto> {
+    await requireAccess(this.accessRepository, { auth, permission: Permission.AssetRead, ids: [id] });
+    if (!(await this.videoIndexRepository.hasAppearances())) {
+      return { durationMs: null, appearances: [] };
+    }
+
+    const rows = await this.videoIndexRepository.getAppearances(id);
+    const appearances: VideoAppearanceDto[] = rows
+      .map((row) => ({
+        person: {
+          id: row.personId,
+          name: row.name,
+          isHidden: row.isHidden,
+          color: row.color ?? undefined,
+          updatedAt: new Date(row.updatedAt).toISOString(),
+        },
+        segments: row.segments,
+      }))
+      .sort((a, b) => screenTime(b.segments) - screenTime(a.segments));
+    return { durationMs: rows[0]?.durationMs ?? null, appearances };
+  }
+}
