+import { createZodDto } from 'nestjs-zod';
+import z from 'zod';
+
+const VideoAppearanceSchema = z
+  .object({
+    person: z
+      .object({
+        id: z.string().describe('Person ID'),
+        name: z.string().describe('Person name'),
+        isHidden: z.boolean().describe('Whether the person is hidden'),
+        color: z.string().optional().describe('Person color'),
+        updatedAt: z.string().describe('Last update date'),
+      })
+      .describe('Person on screen'),
+    segments: z
+      .array(z.tuple([z.int(), z.int()]))
+      .describe('Intervals the person is on screen, as [startMs, endMs], sorted and non-overlapping'),
+  })
+  .meta({ id: 'VideoAppearanceDto' });
+
+const VideoAppearancesResponseSchema = z
+  .object({
+    durationMs: z.int().nullable().describe('Video duration in milliseconds, when known'),
+    appearances: z.array(VideoAppearanceSchema).describe('People on screen, most screen time first'),
+  })
+  .meta({ id: 'VideoAppearancesResponseDto' });
+
+export class VideoAppearancesResponseDto extends createZodDto(VideoAppearancesResponseSchema) {}
+export type VideoAppearanceDto = z.infer<typeof VideoAppearanceSchema>;
