diff --git a/server/src/repositories/video-index.repository.ts b/server/src/repositories/video-index.repository.ts
new file mode 100644
index 0000000..c70214f
--- /dev/null
+++ b/server/src/repositories/video-index.repository.ts
@@ -0,0 +1,130 @@
+import { Injectable } from '@nestjs/common';
+import { type Kysely, sql } from 'kysely';
+import { InjectKysely } from 'nestjs-kysely';
+import { DB } from 'src/schema/index.js';
+
+/**
+ * Read-only access to the video index published by immich-video-face
+ * (https://github.com/DigitalCyberSoft/ImmichVideoFace).
+ *
+ * The scanner keeps two things Immich has no place for, in a schema that its own
+ * database role owns (`ivf` unless IMMICH_VIDEO_INDEX_SCHEMA says otherwise):
+ *   - appearance:      when each person is on screen in a video
+ *   - frame_embedding: CLIP embeddings of frames sampled through each video
+ * Immich never writes there. Without the schema, everything here is a no-op.
+ */
+export const VIDEO_INDEX_SCHEMA = process.env.IMMICH_VIDEO_INDEX_SCHEMA || 'ivf';
+
+const RECHECK_MS = 60_000;
+let cache: { at: number; tables: Set<string> } | undefined;
+
+/** Which video-index tables exist, re-checked at most once a minute. */
+export const videoIndexTables = async (db: Kysely<DB>): Promise<Set<string>> => {
+  if (cache && Date.now() - cache.at < RECHECK_MS) {
+    return cache.tables;
+  }
+  const { rows } = await sql<{ name: string }>`
+    select table_name as name from information_schema.tables
+    where table_schema = ${VIDEO_INDEX_SCHEMA} and table_name in ('appearance', 'frame_embedding')
+  `.execute(db);
+  cache = { at: Date.now(), tables: new Set(rows.map((row) => row.name)) };
+  return cache.tables;
+};
+
+export const hasVideoFrames = async (db: Kysely<DB>): Promise<boolean> => {
+  const tables = await videoIndexTables(db);
+  return tables.has('frame_embedding');
+};
+
+/**
+ * Per asset, the smallest CLIP distance over its own embedding and every sampled frame
+ * of it. Frames are only compared when they were embedded with the model in use, so a
+ * model change can never mix vector spaces. Exhaustive rather than indexed: it scores
+ * every embedding, which is exact, and fast enough for a personal library.
+ */
+export const nearestAssetsWithFrames = (embedding: string, model: string) =>
+  sql<{ assetId: string; distance: number }>`(
+    select candidate."assetId", min(candidate.distance) as distance
+    from (
+      select smart_search."assetId", smart_search.embedding <=> ${embedding} as distance
+      from smart_search
+      union all
+      select frame.asset_id, frame.embedding <=> ${embedding}::vector
+      from ${sql.id(VIDEO_INDEX_SCHEMA, 'frame_embedding')} frame
+      where frame.model = ${model}
+    ) candidate
+    group by candidate."assetId"
+  )`;
+
+export type VideoAppearanceRow = {
+  durationMs: number | null;
+  personId: string;
+  name: string;
+  isHidden: boolean;
+  color: string | null;
+  updatedAt: Date;
+  segments: [number, number][];
+};
+
+@Injectable()
+export class VideoIndexRepository {
+  constructor(@InjectKysely() private db: Kysely<DB>) {}
+
+  async hasAppearances() {
+    const tables = await videoIndexTables(this.db);
+    return tables.has('appearance');
+  }
+
+  /**
+   * Who is on screen when, for one video. A row follows the face it was recorded with,
+   * so a merged or reassigned person is reported as whoever now owns that face; the
+   * person id saved at scan time is the fallback when the face is gone.
+   */
+  async getAppearances(assetId: string): Promise<VideoAppearanceRow[]> {
+    const { rows } = await sql<VideoAppearanceRow>`
+      select
+        asset.duration as "durationMs",
+        person."personGroupId" as "personId",
+        person.name,
+        person."isHidden",
+        person.color,
+        person."updatedAt",
+        appearance.segments
+      from ${sql.id(VIDEO_INDEX_SCHEMA, 'appearance')} appearance
+      inner join asset on asset.id = appearance.asset_id and asset."deletedAt" is null
+      left join asset_face face
+        on face.id = appearance.face_id
+        and face."assetId" = appearance.asset_id
+        and face."deletedAt" is null
+      inner join person
+        on person."personGroupId" = coalesce(face."personGroupId", appearance.person_id)
+        and person."ownerId" = asset."ownerId"
+      where appearance.asset_id = ${assetId}
+    `.execute(this.db);
+
+    // Two rows can land on one person after a merge; their screen time is combined.
+    const byPerson = new Map<string, VideoAppearanceRow>();
+    for (const row of rows) {
+      const existing = byPerson.get(row.personId);
+      if (existing) {
+        existing.segments = mergeSegments([...existing.segments, ...row.segments]);
+      } else {
+        byPerson.set(row.personId, { ...row, segments: mergeSegments(row.segments) });
+      }
+    }
+    return byPerson.values().toArray();
+  }
+}
+
+export const mergeSegments = (segments: [number, number][]): [number, number][] => {
+  const merged: [number, number][] = [];
+  for (const [start, end] of [...segments].sort((a, b) => a[0] - b[0])) {
+    const last = merged.at(-1);
+    if (last && start <= last[1]) {
+      last[1] = Math.max(last[1], end);
+    } else {
+      merged.push([start, end]);
+    }
+  }
+  return merged;
+};
