+import { Controller, Get, Param } from '@nestjs/common';
+import { ApiTags } from '@nestjs/swagger';
+import type { AuthDto } from 'src/dtos/auth.dto.js';
+import { Endpoint, HistoryBuilder } from 'src/decorators.js';
+import { VideoAppearancesResponseDto } from 'src/dtos/video-index.dto.js';
+import { ApiTag, Permission, RouteKey } from 'src/enum.js';
+import { Auth, Authenticated } from 'src/middleware/auth.guard.js';
+import { VideoIndexService } from 'src/services/video-index.service.js';
+import { UUIDParamDto } from 'src/validation.js';
+
+@ApiTags(ApiTag.Assets)
+@Controller(RouteKey.Asset)
+export class VideoIndexController {
+  constructor(private service: VideoIndexService) {}
+
+  @Get(':id/appearances')
+  @Authenticated({ permission: Permission.AssetRead })
+  @Endpoint({
+    summary: 'Retrieve who is on screen when in a video',
+    description:
+      'People recognised throughout a video and the intervals they are on screen, from the immich-video-face index. Empty when the video has not been indexed.',
+    history: new HistoryBuilder().added('v3.3.5'),
+  })
+  getAppearances(@Auth() auth: AuthDto, @Param() { id }: UUIDParamDto): Promise<VideoAppearancesResponseDto> {
+    return this.service.getAppearances(auth, id);
+  }
+}
