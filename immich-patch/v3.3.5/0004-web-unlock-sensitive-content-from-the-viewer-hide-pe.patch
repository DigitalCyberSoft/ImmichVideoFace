   const { Edit, Favorite, Unfavorite, HidePerson, ShowPerson, Access } = $derived(getPersonActions($t, person));
+  // Sensitive people: every photo and video showing them is blurred until the PIN is entered.
+  let sensitivePerson = $state<{ sensitive: boolean; hidden: boolean; available: boolean }>();
+  $effect(() => {
+    const id = person.id;
+    sensitivePerson = undefined;
+    fetch(`/api/people/${id}/sensitive`)
+      .then((response) => (response.ok ? response.json() : undefined))
+      .then((body) => (sensitivePerson = body))
+      .catch(() => {});
+  });
+
+  const setPersonSensitive = async (sensitive: boolean) => {
+    const response = await fetch(`/api/people/${person.id}/sensitive`, {
+      method: 'PUT',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ sensitive }),
+    });
+    if (response.status === 401 && !sensitive) {
+      // Showing them again takes the PIN, like viewing them.
+      location.assign(Route.pinPrompt({ continue: $page.url.pathname }));
+      return;
+    }
+    if (!response.ok) {
+      handleError(new Error(await response.text()), 'Could not change whether this person is hidden');
+      return;
+    }
+    location.reload();
+  };
+
+  const HideBehindPin: ActionItem = {
+    title: 'Hide behind PIN',
+    icon: mdiShieldLockOutline,
+    $if: () => !!sensitivePerson?.available && !sensitivePerson.sensitive,
+    onAction: () => setPersonSensitive(true),
+  };
+
+  const StopHidingBehindPin: ActionItem = {
+    title: 'Stop hiding behind PIN',
+    icon: mdiShieldLockOpenOutline,
+    $if: () => !!sensitivePerson?.sensitive,
+    onAction: () => setPersonSensitive(false),
+  };
+
   const SelectFeaturePhoto: ActionItem = {
     title: $t('select_featured_photo'),
     icon: mdiAccountBoxOutline,
