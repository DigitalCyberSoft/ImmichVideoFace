@@ -0,0 +1,83 @@
+<script lang="ts">
+  // Sensitive content: an asset carrying the server's sensitive tag (IMMICH_SENSITIVE_TAG, "Sensitive"
+  // by default, or a tag under it) is served blurred until the session is unlocked with the PIN, the
+  // same unlock as the Locked Folder. This offers that unlock, and the way to hide it all again.
+  import { page } from '$app/state';
+  import { authManager } from '$lib/managers/auth-manager.svelte';
+  import { Route } from '$lib/route';
+  import { lockAuthSession } from '@immich/sdk';
+  import { Button, Icon } from '@immich/ui';
+  import { mdiEyeOff, mdiEyeOffOutline } from '@mdi/js';
+
+  interface Props {
+    assetId: string;
+    onHiddenChange?: (hidden: boolean) => void;
+  }
+
+  const { assetId, onHiddenChange }: Props = $props();
+
+  let sensitive = $state(false);
+  let hidden = $state(false);
+
+  $effect(() => {
+    const id = assetId;
+    sensitive = false;
+    hidden = false;
+    onHiddenChange?.(false);
+    // authManager.params carries a shared link's key, as the media URLs do.
+    const params = Object.entries(authManager.params)
+      .filter(([, value]) => value)
+      .map(([key, value]) => `${encodeURIComponent(key)}=${encodeURIComponent(String(value))}`)
+      .join('&');
+    const controller = new AbortController();
+    fetch(`/api/assets/${id}/sensitive?${params}`, { signal: controller.signal })
+      .then((response) => (response.ok ? response.json() : undefined))
+      .then((body?: { sensitive: boolean; hidden: boolean }) => {
+        sensitive = !!body?.sensitive;
+        hidden = sensitive && !!body?.hidden;
+        onHiddenChange?.(hidden);
+      })
+      .catch(() => {});
+    return () => controller.abort();
+  });
+
+  // A full load afterwards, so every blurred image already on the page is fetched again.
+  const unlock = () => {
+    location.assign(Route.pinPrompt({ continue: page.url.pathname + page.url.search }));
+  };
+
+  const hideAgain = async () => {
+    try {
+      await lockAuthSession();
+    } finally {
+      location.reload();
+    }
+  };
+</script>
+
+{#if hidden}
+  <div class="absolute inset-0 z-10 flex items-center justify-center">
+    <div class="flex flex-col items-center gap-3 rounded-2xl bg-black/60 px-8 py-6 text-center text-white">
+      <Icon icon={mdiEyeOff} size="48" />
+      <p class="text-lg font-medium">Sensitive content</p>
+      {#if authManager.isSharedLink}
+        <p class="max-w-64 text-sm text-white/80">Hidden on shared links.</p>
+      {:else}
+        <p class="max-w-64 text-sm text-white/80">Hidden until you enter your PIN.</p>
+        <Button size="small" onclick={unlock}>Show</Button>
+      {/if}
+    </div>
+  </div>
+{:else if sensitive && !authManager.isSharedLink}
+  <div class="absolute inset-s-4 bottom-24 z-10">
+    <button
+      type="button"
+      class="flex items-center gap-1.5 rounded-full bg-black/60 px-3 py-1.5 text-xs text-white hover:bg-black/80"
+      title="Sensitive content is showing because this session is unlocked. Lock it to hide it again."
+      onclick={hideAgain}
+    >
+      <Icon icon={mdiEyeOffOutline} size="14" />
+      Sensitive · hide again
+    </button>
+  </div>
+{/if}
