+++ b/web/src/lib/components/asset-viewer/VideoPeopleTimeline.svelte
@@ -0,0 +1,98 @@
+<script lang="ts">
+  // immich-video-face: who is on screen when, drawn as rows lined up with the time range below.
+  // Data comes from GET /api/assets/:id/appearances, which is empty unless the video was indexed.
+  import { assetViewerManager } from '$lib/managers/asset-viewer-manager.svelte';
+  import { authManager } from '$lib/managers/auth-manager.svelte';
+  import { getPeopleThumbnailUrl } from '$lib/utils';
+  import type { PersonResponseDto } from '@immich/sdk';
+
+  type Appearance = {
+    person: { id: string; name: string; isHidden: boolean; color?: string; updatedAt: string };
+    segments: [number, number][];
+  };
+
+  interface Props {
+    assetId: string;
+    videoPlayer: HTMLVideoElement | undefined;
+  }
+
+  const { assetId, videoPlayer }: Props = $props();
+
+  const MAX_ROWS = 5;
+  const PALETTE = ['#60a5fa', '#fbbf24', '#34d399', '#f87171', '#a78bfa', '#22d3ee'];
+
+  let appearances = $state<Appearance[]>([]);
+  let durationMs = $state(0);
+
+  $effect(() => {
+    const id = assetId;
+    appearances = [];
+    durationMs = 0;
+    if (authManager.isSharedLink) {
+      return;
+    }
+    const controller = new AbortController();
+    fetch(`/api/assets/${id}/appearances`, { signal: controller.signal })
+      .then((response) => (response.ok ? response.json() : undefined))
+      .then((body?: { durationMs: number | null; appearances: Appearance[] }) => {
+        if (body) {
+          appearances = body.appearances ?? [];
+          durationMs = body.durationMs ?? 0;
+        }
+      })
+      .catch(() => {});
+    return () => controller.abort();
+  });
+
+  const rows = $derived(
+    appearances.filter((a) => assetViewerManager.isShowingHiddenPeople || !a.person.isHidden).slice(0, MAX_ROWS),
+  );
+
+  const formatTime = (ms: number) => {
+    const total = Math.round(ms / 1000);
+    const minutes = Math.floor(total / 60);
+    const seconds = String(total % 60).padStart(2, '0');
+    return minutes >= 60
+      ? `${Math.floor(minutes / 60)}:${String(minutes % 60).padStart(2, '0')}:${seconds}`
+      : `${minutes}:${seconds}`;
+  };
+
+  const percent = (ms: number) => `${Math.min(100, Math.max(0, (ms / durationMs) * 100))}%`;
+
+  const seek = (event: Event, ms: number) => {
+    event.stopPropagation();
+    if (videoPlayer) {
+      videoPlayer.currentTime = ms / 1000;
+    }
+  };
+</script>
+
+{#if rows.length > 0 && durationMs > 0}
+  <div class="mb-1 flex w-full flex-col gap-1.5 px-2" role="group" aria-label="People on screen">
+    {#each rows as { person, segments }, index (person.id)}
+      {@const color = person.color || PALETTE[index % PALETTE.length]}
+      {@const label = person.name || 'Unnamed person'}
+      <div class="relative h-1.5 w-full">
+        <img
+          src={getPeopleThumbnailUrl(person as unknown as PersonResponseDto)}
+          alt={label}
+          title={label}
+          class="pointer-events-none absolute top-1/2 -left-5.5 size-4 -translate-y-1/2 rounded-full object-cover"
+          style:outline="1.5px solid {color}"
+        />
+        {#each segments as [start, end] (start)}
+          <button
+            type="button"
+            class="absolute top-0 h-full min-w-1 cursor-pointer rounded-sm opacity-75 transition-opacity hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-1 focus-visible:outline-white"
+            style:left={percent(start)}
+            style:width={percent(end - start)}
+            style:background={color}
+            title="{label} · {formatTime(start)}–{formatTime(end)}"
+            aria-label="{label}, {formatTime(start)} to {formatTime(end)}"
+            onclick={(event) => seek(event, start)}
+          ></button>
+        {/each}
+      </div>
+    {/each}
+  </div>
+{/if}
