-export const getSearchPeopleTitle = (people: PersonResponseDto[], selected: SvelteSet<string>) => {
+export const getSearchPeopleTitle = (
+  people: PersonResponseDto[],
+  selected: SvelteSet<string>,
+  excluded?: SvelteSet<string>,
+) => {
+  const included = describePeople(people, selected);
+  const left = excluded ? describePeople(people, excluded) : undefined;
+  if (!left) {
+    return included;
+  }
+  return included ? `${included}, not ${left}` : `Not ${left}`;
+};
+
+const describePeople = (people: PersonResponseDto[], selected: SvelteSet<string>) => {
   if (selected.size === 0) {
     return;
   }
