index 0000000..db60f3a
--- /dev/null
+++ b/web/src/lib/components/shared-components/navigation-bar/SensitiveLockButton.svelte
@@ -0,0 +1,54 @@
+<script lang="ts">
+  // Sensitive content: while the session is unlocked with the PIN, everything hidden behind
+  // it shows. This says so, and locks it again. Checked on each navigation and every minute.
+  import { afterNavigate } from '$app/navigation';
+  import { authManager } from '$lib/managers/auth-manager.svelte';
+  import { getAuthStatus, lockAuthSession } from '@immich/sdk';
+  import { IconButton } from '@immich/ui';
+  import { mdiLockOpenVariantOutline } from '@mdi/js';
+  import { onDestroy, onMount } from 'svelte';
+
+  let unlocked = $state(false);
+
+  const check = async () => {
+    if (!authManager.authenticated || authManager.isSharedLink) {
+      unlocked = false;
+      return;
+    }
+    try {
+      const status = await getAuthStatus();
+      unlocked = status.isElevated;
+    } catch {
+      unlocked = false;
+    }
+  };
+
+  const lock = async () => {
+    try {
+      await lockAuthSession();
+    } finally {
+      location.reload();
+    }
+  };
+
+  let timer: ReturnType<typeof setInterval> | undefined;
+  onMount(() => {
+    void check();
+    timer = setInterval(() => void check(), 60_000);
+  });
+  onDestroy(() => clearInterval(timer));
+  afterNavigate(() => void check());
+</script>
+
+{#if unlocked}
+  <IconButton
+    shape="round"
+    color="danger"
+    variant="ghost"
+    size="medium"
+    icon={mdiLockOpenVariantOutline}
+    title="Sensitive content is showing (unlocked with your PIN). Click to hide it again."
+    aria-label="Hide sensitive content"
+    onclick={lock}
+  />
+{/if}
